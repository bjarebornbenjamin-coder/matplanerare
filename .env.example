# --- Server (Vercel → Project Settings → Environment Variables). Aldrig VITE_-prefix på hemligheter. ---
OPENAI_API_KEY=sk-...          # OpenAI-nyckeln. Ligger bara på servern.
# APP_PASSWORD=välj-ett-långt-lösenord  # VALFRITT. Utan det är åtkomsten öppen (alla med adressen kan använda nyckeln)
RATE_LIMIT_PER_MIN=20          # valfritt, standard 20 anrop/min


# --- Synk och inloggning (3.2) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co     # bakas in i appen vid bygge (publik)
VITE_SUPABASE_ANON_KEY=eyJ...                   # publik anon-nyckel
SUPABASE_URL=https://xxxx.supabase.co           # samma värden för serverfunktionerna
SUPABASE_ANON_KEY=eyJ...
ALLOWED_EMAILS=du@example.com                   # vilka inloggade som får använda OpenAI-anropen (kommaseparerat)


# --- Push-notiser (3.3) ---
VITE_VAPID_PUBLIC_KEY=B...                      # npx web-push generate-vapid-keys (publik, bakas in i appen)
VAPID_PUBLIC_KEY=B...                           # samma publika nyckel för servern
VAPID_PRIVATE_KEY=...                           # HEMLIG
VAPID_SUBJECT=mailto:du@example.com
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # HEMLIG, bara på servern
CRON_SECRET=lång-slumpmässig-sträng             # skyddar /api/push-dispatch



# --- Recept från nätet (valfritt) ---
# RECIPE_SEARCH_MODEL=gpt-4.1-mini   # valfritt: modell som provas först för receptsökning (Responses API + web_search)
